# PARIVAR PUBLIC DEMO ONLY. Never put private/production credentials here.

# A dedicated MongoDB database/cluster created only for the public demo.
MONGO_URI=mongodb+srv://<demo-user>:<demo-password>@<demo-cluster>.mongodb.net/parivar_demo?retryWrites=true&w=majority

# Required: generate a new random secret for this demo deployment.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=<generate-a-unique-random-secret-at-least-32-characters>

# Safety switches. The server refuses to start unless DEMO_MODE=true.
DEMO_MODE=true
DEMO_FID=PARIVAR_DEMO
DEMO_MEMBER_ID=1051

# Comma-separated deployed frontend origin(s).
FRONTEND_URLS=http://localhost:5173,https://your-parivar-demo-frontend.example

PORT=4000
NODE_ENV=development
